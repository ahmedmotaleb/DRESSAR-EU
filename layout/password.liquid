<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {%- liquid
      assign body_font = settings.body_font
      assign heading_font = settings.heading_font
    -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {{ heading_font | font_face: font_display: 'swap' }}
    <style>
      :root {
        --bg: {{ settings.color_bg }};
        --surface: {{ settings.color_surface }};
        --ink: {{ settings.color_ink }};
        --muted: {{ settings.color_muted }};
        --line: {{ settings.color_line }};
        --accent: {{ settings.color_accent }};
        --accent-soft: {{ settings.color_accent_soft }};
        --sale: {{ settings.color_sale }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --body-weight: {{ body_font.weight }};
        --heading-weight: {{ heading_font.weight }};
        --heading-scale: 1;
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <main class="password" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
