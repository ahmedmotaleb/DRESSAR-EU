<section class="section">
  <div class="wrap">
    <div class="faq">
      <div class="section-head section-head--center">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
      </div>

      <div class="accordion">
        {%- for block in section.blocks -%}
          <div class="accordion__item" {{ block.shopify_attributes }}>
            <h3 style="margin:0">
              <button
                type="button"
                class="accordion__trigger"
                aria-expanded="false"
                aria-controls="Faq-{{ block.id }}">
                <span>{{ block.settings.question }}</span>
                <span class="plus" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="accordion__panel rte" id="Faq-{{ block.id }}" hidden>{{ block.settings.answer }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take in Ireland?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders placed before 1pm are dispatched the same working day and arrive within 2–4 working days nationwide.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
