<section class="usp">
  <div class="wrap">
    <div class="usp__grid">
      {%- for block in section.blocks -%}
        <div class="usp__item" {{ block.shopify_attributes }}>
          {% render 'icon', icon: block.settings.icon %}
          <span class="usp__title">{{ block.settings.title }}</span>
          <span class="usp__body">{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "truck",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "lock", "label": "Secure" },
            { "value": "leaf", "label": "Quality" },
            { "value": "chat", "label": "Support" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free delivery over €75" },
        { "type": "text", "id": "text", "label": "Text", "default": "Ireland, 2–4 working days" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Free delivery over €75", "text": "Ireland, 2–4 working days" } },
        { "type": "item", "settings": { "icon": "return", "title": "30-day returns", "text": "Beyond your 14-day EU right" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Secure checkout", "text": "Card, Apple Pay, Google Pay" } },
        { "type": "item", "settings": { "icon": "chat", "title": "Here to help", "text": "Mon–Fri, 9am–5pm IST" } }
      ]
    }
  ]
}
{% endschema %}
