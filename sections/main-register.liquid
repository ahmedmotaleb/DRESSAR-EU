<div class="wrap section">
  <div style="max-width:420px;margin-inline:auto">
    <h1 class="center">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer' -%}
      <div class="stack">
        {%- if form.errors -%}
          <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="field">
          <label for="RegFirst">{{ 'customer.register.first_name' | t }}</label>
          <input type="text" id="RegFirst" name="customer[first_name]" autocomplete="given-name">
        </div>
        <div class="field">
          <label for="RegLast">{{ 'customer.register.last_name' | t }}</label>
          <input type="text" id="RegLast" name="customer[last_name]" autocomplete="family-name">
        </div>
        <div class="field">
          <label for="RegEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="RegEmail" name="customer[email]" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="RegPassword">{{ 'customer.login.password' | t }}</label>
          <input type="password" id="RegPassword" name="customer[password]" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn--full">{{ 'customer.register.submit' | t }}</button>
        <p class="center muted" style="font-size:var(--step--1)">We process your details under our <a href="/policies/privacy-policy">Privacy Policy</a>.</p>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Register" }
{% endschema %}
