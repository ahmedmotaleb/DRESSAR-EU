<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <p class="footer__brandline">{{ section.settings.brand_line }}</p>
        <p class="muted">{{ section.settings.brand_text }}</p>
        {% render 'social-links' %}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- elsif block.type == 'contact' -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            <ul>
              {%- if block.settings.email != blank -%}
                <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
              {%- endif -%}
              {%- if block.settings.phone != blank -%}
                <li><a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a></li>
              {%- endif -%}
              {%- if block.settings.hours != blank -%}
                <li><span class="muted">{{ block.settings.hours }}</span></li>
              {%- endif -%}
              {%- if block.settings.address != blank -%}
                <li><span class="muted">{{ block.settings.address }}</span></li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.company_number != blank %} · {{ section.settings.company_number }}{% endif %}</span>

      <div class="footer__legal">
        <a href="/policies/privacy-policy">Privacy</a>
        <a href="/policies/terms-of-service">Terms</a>
        <a href="/policies/refund-policy">Returns</a>
        <a href="/pages/delivery">Delivery</a>
      </div>

      {%- if section.settings.show_payment_icons -%}
        <div class="payment-icons" aria-label="{{ 'sections.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand_line", "label": "Brand line", "default": "Modest wear, made to be worn." },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand text",
      "default": "Dressar designs modest clothing for everyday life — abayas, skirts, blouses and dresses, now delivered across Ireland and the EU."
    },
    { "type": "text", "id": "company_number", "label": "Company / VAT number", "info": "Shown in the footer. Required on Irish commercial websites." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Customer care" },
        { "type": "text", "id": "email", "label": "Email", "default": "hello@dressar.ie" },
        { "type": "text", "id": "phone", "label": "Phone" },
        { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Fri, 9am–5pm (IST)" },
        { "type": "textarea", "id": "address", "label": "Address" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Help" } },
      { "type": "contact", "settings": { "heading": "Customer care" } }
    ]
  }
}
{% endschema %}
