<section class="section newsletter">
  <div class="wrap">
    <div class="newsletter__inner">
      <h2>{{ section.settings.heading | default: 'general.newsletter.heading' | t }}</h2>
      <p class="muted">{{ section.settings.text }}</p>

      {%- form 'customer', class: 'newsletter__form-wrap' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,ireland">
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success">{{ 'general.newsletter.success' | t }}</p>
        {%- else -%}
          <div class="newsletter__form">
            <label class="visually-hidden" for="NewsletterEmail">{{ 'general.newsletter.placeholder' | t }}</label>
            <input
              id="NewsletterEmail"
              type="email"
              name="contact[email]"
              placeholder="{{ 'general.newsletter.placeholder' | t }}"
              autocomplete="email"
              required>
            <button type="submit" class="btn">{{ 'general.newsletter.submit' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p class="form-status form-status--error" style="margin-top:12px">{{ form.errors.messages.email }}</p>
          {%- endif -%}
          <p class="newsletter__consent">{{ 'general.newsletter.consent' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Dressar list" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New arrivals, restocks and private sales — to your inbox, never more than weekly." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
