<div class="wrap section">
  <div style="max-width:560px;margin-inline:auto">
    <h1>{{ section.settings.heading }}</h1>
    <div class="rte">{{ section.settings.text }}</div>

    {%- form 'contact', class: 'stack', style: 'margin-top:28px' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success">Thanks — we'll reply within one working day.</p>
      {%- elsif form.errors -%}
        <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="field"><label for="ContactName">Name</label><input type="text" id="ContactName" name="contact[name]" autocomplete="name" required></div>
      <div class="field"><label for="ContactEmail">Email</label><input type="email" id="ContactEmail" name="contact[email]" autocomplete="email" required></div>
      <div class="field"><label for="ContactOrder">Order number (optional)</label><input type="text" id="ContactOrder" name="contact[order]"></div>
      <div class="field"><label for="ContactBody">Message</label><textarea id="ContactBody" name="contact[body]" rows="5" required></textarea></div>
      <button type="submit" class="btn">Send message</button>
      <p class="muted" style="font-size:var(--step--1)">We use your details only to answer you — see our <a href="/policies/privacy-policy">Privacy Policy</a>.</p>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about sizing, an order or a return? Send us a message and we'll come back to you within one working day (Mon–Fri, 9am–5pm IST).</p>" }
  ]
}
{% endschema %}
