<div class="wrap section">
  <div class="collection-head"><h1>{{ blog.title }}</h1></div>
  {%- paginate blog.articles by 12 -%}
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <article class="card">
          <a class="card__media card__media--portrait" href="{{ article.url }}">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" width="800" height="1066" loading="lazy">
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>
          <div class="card__body">
            <span class="card__meta">{{ article.published_at | date: '%-d %B %Y' }}</span>
            <h2 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="card__meta">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog" }
{% endschema %}
