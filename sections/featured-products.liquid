<section class="section">
  <div class="wrap">
    <div class="section-head{% if section.settings.center %} section-head--center{% endif %}">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.collection != blank -%}
        <a class="link-underline" href="{{ section.settings.collection.url }}">View all</a>
      {%- endif -%}
    </div>

    <div class="grid grid--4">
      {%- for product in section.settings.collection.products limit: section.settings.count -%}
        {% render 'product-card', card_product: product %}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="card">
            <div class="card__media card__media--tall">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="card__body"><h3 class="card__title">Example product</h3></div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New this week" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "min": 4, "max": 16, "step": 4, "label": "Products", "default": 8 },
    { "type": "checkbox", "id": "center", "label": "Centre heading", "default": false }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
