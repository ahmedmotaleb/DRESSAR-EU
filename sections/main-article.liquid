<article class="wrap section">
  <div class="wrap--narrow" style="margin-inline:auto;padding-inline:0">
    <p class="eyebrow">{{ article.published_at | date: '%-d %B %Y' }}</p>
    <h1>{{ article.title }}</h1>
    {%- if article.image -%}
      <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.image.alt | escape }}" width="1400" height="900" style="margin:28px 0;border-radius:var(--radius)">
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p style="margin-top:36px"><a class="link-underline" href="{{ blog.url }}">{{ 'blogs.article.back' | t }}</a></p>
  </div>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
