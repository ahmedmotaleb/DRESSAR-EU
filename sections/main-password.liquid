<div class="password__inner">
  <h1 class="header__wordmark" style="font-size:var(--step-3)">{{ settings.wordmark | default: shop.name }}</h1>
  <p class="header__suffix">{{ settings.wordmark_suffix }}</p>
  <p class="muted">{{ section.settings.text }}</p>

  {%- form 'customer', id: 'PasswordNewsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter,prelaunch,ireland">
    {%- if form.posted_successfully? -%}
      <p class="form-status form-status--success">{{ 'general.newsletter.success' | t }}</p>
    {%- else -%}
      <div class="newsletter__form">
        <label class="visually-hidden" for="PasswordEmail">{{ 'general.newsletter.placeholder' | t }}</label>
        <input id="PasswordEmail" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
        <button type="submit" class="btn">{{ 'general.newsletter.submit' | t }}</button>
      </div>
    {%- endif -%}
  {%- endform -%}

  <details style="margin-top:18px">
    <summary style="cursor:pointer;font-size:var(--step--1)">Enter using password</summary>
    <div style="margin-top:14px">{{ shop.password_message }}{% form 'storefront_password' %}
      <div class="newsletter__form">
        <label class="visually-hidden" for="StorePassword">Password</label>
        <input id="StorePassword" type="password" name="password" placeholder="Password">
        <button type="submit" class="btn">Enter</button>
      </div>
      {%- if form.errors -%}<p class="form-status form-status--error" style="margin-top:10px">{{ form.errors.messages.form }}</p>{%- endif -%}
    {% endform %}</div>
  </details>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "textarea", "id": "text", "label": "Text", "default": "Dressar is coming to Ireland. Leave your email and we'll tell you the moment we open." }
  ]
}
{% endschema %}
