{%- liquid
  assign align = section.settings.alignment
  assign light = section.settings.text_light
-%}
<section class="hero hero--{{ section.settings.height }} hero--{{ align }}{% if light %} hero--light{% endif %}">
  <div class="hero__media{% unless section.settings.image %} hero__placeholder{% endunless %}">
    {%- if section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        fetchpriority="high">
    {%- endif -%}
    {%- if section.settings.overlay_opacity > 0 -%}
      <div class="hero__overlay" style="background: rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }})"></div>
    {%- endif -%}
  </div>

  <div class="hero__content">
    <div class="hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow"{% if light %} style="color:inherit;opacity:.8"{% endif %}>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hero__text">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.cta_label != blank -%}
          <a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="btn btn--outline" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Now delivering to Ireland" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Modest wear, made to be worn." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Abayas, skirts, blouses and dresses cut for real life — and now delivered across Ireland in a few days." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop new arrivals" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "cta2_label", "label": "Second button label", "default": "Best sellers" },
    { "type": "url", "id": "cta2_link", "label": "Second button link" },
    {
      "type": "select", "id": "height", "label": "Height", "default": "lg",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ]
    },
    {
      "type": "select", "id": "alignment", "label": "Content position", "default": "start",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "end", "label": "Right" }
      ]
    },
    { "type": "checkbox", "id": "text_light", "label": "Light text", "default": true },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Image overlay", "default": 25 }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
