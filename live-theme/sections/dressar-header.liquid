{{ 'dressar-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dressar-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign overlay = false
  if section.settings.enable_overlay
    case request.page_type
      when 'index'
        assign overlay = section.settings.overlay_on_home
      when 'collection'
        assign overlay = section.settings.overlay_on_collection
      when 'product'
        assign overlay = section.settings.overlay_on_product
      when 'page'
        assign overlay = section.settings.overlay_on_page
    endcase
  endif

  assign menu = section.settings.menu

  assign border_px = 0
  if section.settings.show_border
    assign border_px = 1
  endif
  assign pull_mobile = section.settings.height_mobile | plus: border_px
  assign pull_desktop = section.settings.height | plus: border_px
-%}

{% style %}
  /* Stickiness belongs on the section wrapper, not on the <header> inside it: a
     sticky box only sticks within its own parent, and the wrapper is the element
     that spans the page. Dawn's header works the same way. */
  #shopify-section-{{ section.id }} {
    position: {% if section.settings.sticky %}sticky{% else %}relative{% endif %};
    top: 0;
    z-index: 40;
  }
  {%- if overlay %}

  /* The header never leaves normal flow — turning solid on scroll therefore
     reflows nothing. Instead the section below is pulled up underneath it. Both
     the pull-up and the transparency wait on the body class that
     dressar-header.js adds, so a visitor without JavaScript keeps a solid,
     readable header above an un-shifted hero. */
  .dr-overlay-header #MainContent > .shopify-section:first-child {
    margin-top: -{{ pull_mobile }}px;
  }
  @media screen and (min-width: 990px) {
    .dr-overlay-header #MainContent > .shopify-section:first-child {
      margin-top: -{{ pull_desktop }}px;
    }
  }
  {%- endif %}
{% endstyle %}

<header
  class="dressar-header color-{{ section.settings.color_scheme }} gradient{% if section.settings.sticky %} dressar-header--sticky{% endif %}{% if overlay %} dressar-header--overlay{% endif %}{% if section.settings.logo_position == 'start' %} dressar-header--logo-start{% endif %}"
  data-dressar-header
  data-solid-after="{{ section.settings.solid_after }}"
  style="
    --dh-height: {{ section.settings.height_mobile }}px;
    --dh-height-lg: {{ section.settings.height }}px;
    --dh-wordmark: {{ section.settings.wordmark_size }};
    --dh-overlay-fg: {{ section.settings.overlay_text_color.red }}, {{ section.settings.overlay_text_color.green }}, {{ section.settings.overlay_text_color.blue }};
    --dh-border: {% if section.settings.show_border %}1{% else %}0{% endif %}px;
  "
>
  <div class="dressar-header__inner">
    <button
      type="button"
      class="dressar-icon dressar-header__toggle"
      data-dressar-drawer-open
      aria-controls="DressarDrawer"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      {{- 'icon-hamburger.svg' | inline_asset_content -}}
    </button>

    {%- unless section.settings.logo_position == 'start' -%}
      <nav class="dressar-header__nav" role="navigation" aria-label="{{ 'sections.header.menu' | t }}">
        {% render 'dressar-nav', menu: menu, section: section %}
      </nav>
    {%- endunless -%}

    <a
      class="dressar-header__logo"
      href="{{ routes.root_url }}"
      {% if request.page_type == 'index' %}aria-current="page"{% endif %}
    >
      {%- if section.settings.logo != blank -%}
        <img
          class="dressar-header__logo-dark"
          src="{{ section.settings.logo | image_url: width: 600 }}"
          alt="{{ shop.name | escape }}"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          style="width: {{ section.settings.logo_width }}px"
        >
        {%- if section.settings.logo_light != blank -%}
          <img
            class="dressar-header__logo-light"
            src="{{ section.settings.logo_light | image_url: width: 600 }}"
            alt="{{ shop.name | escape }}"
            width="{{ section.settings.logo_light.width }}"
            height="{{ section.settings.logo_light.height }}"
            style="width: {{ section.settings.logo_width }}px"
          >
        {%- endif -%}
      {%- else -%}
        <span class="dressar-header__wordmark">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- if section.settings.logo_position == 'start' -%}
      <nav class="dressar-header__nav" role="navigation" aria-label="{{ 'sections.header.menu' | t }}">
        {% render 'dressar-nav', menu: menu, section: section %}
      </nav>
    {%- endif -%}

    <div class="dressar-header__actions">
      {%- if section.settings.show_localization -%}
        {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
          <div class="dressar-header__locale">
            {%- form 'localization', class: 'localization-form' -%}
              {%- if localization.available_countries.size > 1 -%}
                <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
              {%- endif -%}
              {%- if localization.available_languages.size > 1 -%}
                <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      <a class="dressar-icon" href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}">
        {{- 'icon-search.svg' | inline_asset_content -}}
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a
          class="dressar-icon"
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          aria-label="{{ 'customer.account_fallback' | t }}"
        >
          {{- 'icon-account.svg' | inline_asset_content -}}
        </a>
      {%- endif -%}

      <a class="dressar-icon" href="{{ routes.cart_url }}" aria-label="{{ 'templates.cart.cart' | t }}">
        {{- 'icon-cart.svg' | inline_asset_content -}}
        <span class="dressar-icon__count" data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<div
  class="dressar-drawer color-{{ section.settings.color_scheme }} gradient"
  id="DressarDrawer"
  data-dressar-drawer
  data-open="false"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'sections.header.menu' | t }}"
>
  <div class="dressar-drawer__head">
    <span class="dressar-header__wordmark">{{ shop.name }}</span>
    <button
      type="button"
      class="dressar-icon"
      data-dressar-drawer-close
      aria-label="{{ 'accessibility.close' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>
  </div>

  <ul class="dressar-drawer__list" role="list">
    {%- for link in menu.links -%}
      {%- if link.links.size > 0 -%}
        <li>
          <div class="dressar-drawer__row">
            <a class="dressar-drawer__link" href="{{ link.url }}">{{ link.title }}</a>
            <button
              type="button"
              class="dressar-drawer__expand"
              data-dressar-expand
              aria-expanded="false"
              aria-controls="DrawerSub-{{ forloop.index }}"
              aria-label="{{ link.title | escape }}"
            >
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </button>
          </div>
          <ul class="dressar-drawer__sub" id="DrawerSub-{{ forloop.index }}" role="list" hidden>
            {%- for child in link.links -%}
              <li><a href="{{ child.url }}">{{ child.title }}</a></li>
            {%- endfor -%}
          </ul>
        </li>
      {%- else -%}
        <li><a class="dressar-drawer__link" href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

  <div class="dressar-drawer__foot">
    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      {%- form 'localization', class: 'localization-form' -%}
        {%- if localization.available_countries.size > 1 -%}
          <h2 class="visually-hidden" id="DrawerCountryLabel">{{ 'localization.country_label' | t }}</h2>
          {%- render 'country-localization', localPosition: 'DrawerCountry' -%}
        {%- endif -%}
        {%- if localization.available_languages.size > 1 -%}
          <h2 class="visually-hidden" id="DrawerLanguageLabel">{{ 'localization.language_label' | t }}</h2>
          {%- render 'language-localization', localPosition: 'DrawerLanguage' -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}
  </div>
</div>

<div class="dressar-overlay" data-dressar-overlay hidden></div>

{% schema %}
{
  "name": "Dressar header",
  "class": "dressar-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "image_picker", "id": "logo_light", "label": "Logo — light version", "info": "Used while the header is transparent over a dark image." },
    { "type": "range", "id": "logo_width", "min": 60, "max": 320, "step": 10, "unit": "px", "label": "Logo width", "default": 160 },
    { "type": "range", "id": "wordmark_size", "min": 14, "max": 40, "step": 1, "unit": "px", "label": "Wordmark size", "info": "Used when no logo is set.", "default": 20 },
    {
      "type": "select", "id": "logo_position", "label": "Logo position", "default": "center",
      "options": [{ "value": "center", "label": "Centre, navigation left" }, { "value": "start", "label": "Left, navigation centre" }]
    },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "height", "min": 56, "max": 140, "step": 4, "unit": "px", "label": "Height — desktop", "default": 80 },
    { "type": "range", "id": "height_mobile", "min": 48, "max": 100, "step": 4, "unit": "px", "label": "Height — mobile", "default": 64 },
    { "type": "checkbox", "id": "sticky", "label": "Stick to top on scroll", "default": true },
    { "type": "checkbox", "id": "show_border", "label": "Show bottom border", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "header", "content": "Transparent header" },
    { "type": "paragraph", "content": "Overlays the section below it, then turns solid on scroll. Set a light logo and light text colour so the header stays readable over your hero image." },
    { "type": "checkbox", "id": "enable_overlay", "label": "Enable", "default": true },
    { "type": "checkbox", "id": "overlay_on_home", "label": "On the home page", "default": true },
    { "type": "checkbox", "id": "overlay_on_collection", "label": "On collection pages", "default": false },
    { "type": "checkbox", "id": "overlay_on_product", "label": "On product pages", "default": false },
    { "type": "checkbox", "id": "overlay_on_page", "label": "On content pages", "default": false },
    { "type": "color", "id": "overlay_text_color", "label": "Text while transparent", "default": "#FFFFFF" },
    { "type": "range", "id": "solid_after", "min": 0, "max": 400, "step": 20, "unit": "px", "label": "Turn solid after scrolling", "default": 60 },
    { "type": "header", "content": "Utilities" },
    { "type": "checkbox", "id": "show_localization", "label": "Show country and language selectors", "default": true }
  ],
  "blocks": [
    {
      "type": "mega_promo",
      "name": "Mega menu promotion",
      "settings": [
        { "type": "text", "id": "parent", "label": "Menu item title", "info": "Must match the top-level menu item exactly, e.g. Shop." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "cta", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
