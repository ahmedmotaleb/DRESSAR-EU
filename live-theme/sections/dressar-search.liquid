{{ 'dressar-sections.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
-%}

<div
  class="dr-section color-{{ s.color_scheme }} gradient"
  style="--dr-pt: {{ s.padding_top }}px; --dr-pb: {{ s.padding_bottom }}px;"
>
  <div class="dr-wrap dr-search__head">
    <h1 class="dr-head__title">
      {%- if search.performed -%}
        {{ 'templates.search.search_for' | t: terms: search.terms }}
      {%- else -%}
        {{ 'general.search.search' | t }}
      {%- endif -%}
    </h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="dr-search__form">
      <label class="visually-hidden" for="SearchInput">{{ 'general.search.search' | t }}</label>
      <input
        id="SearchInput"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.search' | t }}"
        autocomplete="off"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="dr-btn"><span>{{ 'general.search.search' | t }}</span></button>
    </form>

    {%- if search.performed -%}
      <p class="dr-search__count" role="status">
        {{- 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count -}}
      </p>
    {%- endif -%}
  </div>

  {%- if search.performed -%}
    {%- paginate search.results by s.results_per_page -%}
      {%- if s.enable_filtering or s.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper page-width{% unless s.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: search,
            enable_filtering: s.enable_filtering,
            enable_sorting: s.enable_sorting,
            filter_type: s.filter_type,
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      <div class="product-grid-container" id="ProductGridContainer">
        {%- if search.results.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="dr-empty">
              <p class="dr-empty__title">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
              <p class="dr-empty__text">
                <a class="dr-head__cta" href="{{ routes.all_products_collection_url }}">
                  {{- 'general.continue_shopping' | t -}}
                </a>
              </p>
            </div>
          </div>
        {%- else -%}
          <div class="collection">
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="dr-wrap dr-grid dr-grid--collection"
              style="--dr-cols: {{ s.columns_desktop }}; --dr-cols-mobile: {{ s.columns_mobile }};"
            >
              {%- for item in search.results -%}
                <li>
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      {% render 'dressar-card',
                        card_product: item,
                        ratio: s.image_ratio,
                        show_second: s.show_secondary_image,
                        meta_source: s.meta_source,
                        index: forloop.index
                      %}
                    {%- when 'article' -%}
                      <a class="dr-result" href="{{ item.url }}">
                        {%- if item.image -%}
                          <span class="dr-result__media">
                            <img
                              src="{{ item.image | image_url: width: 700 }}"
                              alt="{{ item.image.alt | escape }}"
                              width="700" height="875" loading="lazy"
                            >
                          </span>
                        {%- endif -%}
                        <span class="dr-result__kind">{{ 'blogs.article.blog' | t }}</span>
                        <span class="dr-result__title">{{ item.title }}</span>
                      </a>
                    {%- when 'page' -%}
                      <a class="dr-result" href="{{ item.url }}">
                        <span class="dr-result__kind">{{ 'templates.search.page' | t }}</span>
                        <span class="dr-result__title">{{ item.title }}</span>
                      </a>
                  {%- endcase -%}
                </li>
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              <div class="dr-wrap">
                {% render 'pagination', paginate: paginate, anchor: '' %}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% stylesheet %}
.dr-search__head { text-align: center; margin-bottom: 3.2rem; }
.dr-search__form {
  display: flex;
  gap: 1rem;
  max-width: 52rem;
  margin: 2.4rem auto 0;
}
.dr-search__form input[type='search'] {
  flex: 1;
  min-height: 4.8rem;
  padding: 1.2rem 1.6rem;
  font: inherit;
  font-size: 1.5rem;
  color: rgb(var(--color-foreground));
  background: transparent;
  border: 1px solid rgba(var(--color-foreground), .3);
  border-radius: 0;
}
.dr-search__form input[type='search']:focus {
  outline: none;
  border-color: rgb(var(--color-foreground));
}
.dr-search__count { margin: 2rem 0 0; font-size: 1.3rem; opacity: .65; }
.dr-result { display: block; text-decoration: none; color: inherit; text-align: center; }
.dr-result__media { display: block; overflow: hidden; background: rgba(var(--color-foreground), .03); }
.dr-result__media img { width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; }
.dr-result__kind {
  display: block;
  margin-top: 1.4rem;
  font-size: 1.2rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  opacity: .6;
}
.dr-result__title { display: block; margin-top: .5rem; font-size: 1.5rem; }
.dr-result:hover .dr-result__title { text-decoration: underline; text-underline-offset: .3rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Search results",
  "class": "section",
  "settings": [
    { "type": "range", "id": "results_per_page", "min": 8, "max": 36, "step": 4, "label": "Results per page", "default": 24 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    {
      "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "default": "2",
      "options": [{ "value": "1", "label": "One" }, { "value": "2", "label": "Two" }]
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "tall",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "tall", "label": "Tall (2:3)" },
        { "value": "square", "label": "Square" }
      ]
    },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Second image on hover", "default": true },
    {
      "type": "select", "id": "meta_source", "label": "Line above the title", "default": "type",
      "options": [
        { "value": "none", "label": "Nothing" },
        { "value": "type", "label": "Product type" },
        { "value": "fabric", "label": "Fabric metafield" }
      ]
    },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "default": true },
    {
      "type": "select", "id": "filter_type", "label": "Filter layout", "default": "drawer",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Sidebar" },
        { "value": "drawer", "label": "Drawer" }
      ]
    },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ]
}
{% endschema %}
