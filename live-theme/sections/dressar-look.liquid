{{ 'dressar-sections.css' | asset_url | stylesheet_tag }}
{{ 'dressar-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dressar-card.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
-%}

<section
  class="dr-section color-{{ s.color_scheme }} gradient"
  style="--dr-pt: {{ s.padding_top }}px; --dr-pb: {{ s.padding_bottom }}px;"
>
  {%- if s.heading != blank or s.eyebrow != blank -%}
    <div class="dr-wrap dr-head">
      {%- if s.eyebrow != blank -%}<p class="dr-head__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="dr-head__title">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="dr-head__text">{{ s.text }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="dr-wrap">
    <div class="dr-look dr-look--{{ s.image_position }}">
      <div class="dr-look__media">
        {%- if s.image -%}
          <img
            src="{{ s.image | image_url: width: 1400 }}"
            srcset="{{ s.image | image_url: width: 700 }} 700w, {{ s.image | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ s.image.alt | escape }}"
            width="{{ s.image.width }}"
            height="{{ s.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: '' }}
        {%- endif -%}
      </div>

      <div class="dr-look__products">
        <div class="dr-look__grid">
          {%- for block in section.blocks -%}
            {%- if block.settings.product != blank -%}
              <div {{ block.shopify_attributes }}>
                {% render 'dressar-card',
                  card_product: block.settings.product,
                  ratio: 'portrait',
                  show_second: false,
                  meta_source: s.meta_source,
                  show_swatches: true,
                  swatch_limit: 4
                %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.dr-look { display: grid; gap: 2.4rem; align-items: start; }
@media screen and (min-width: 990px) {
  .dr-look { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4rem; }
  .dr-look--right .dr-look__media { order: 2; }
}
.dr-look__media { overflow: hidden; background: rgba(var(--color-foreground), .03); }
.dr-look__media img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
.dr-look__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem; }
@media screen and (min-width: 990px) { .dr-look__grid { gap: 2rem; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop the look",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the look" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Campaign image" },
    {
      "type": "select", "id": "image_position", "label": "Image position", "default": "left",
      "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }]
    },
    {
      "type": "select", "id": "meta_source", "label": "Line above the title", "default": "type",
      "options": [
        { "value": "none", "label": "Nothing" },
        { "value": "type", "label": "Product type" },
        { "value": "fabric", "label": "Fabric metafield" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "look_product",
      "name": "Product",
      "settings": [{ "type": "product", "id": "product", "label": "Product" }]
    }
  ],
  "presets": [
    {
      "name": "Shop the look",
      "blocks": [{ "type": "look_product" }, { "type": "look_product" }, { "type": "look_product" }, { "type": "look_product" }]
    }
  ]
}
{% endschema %}
