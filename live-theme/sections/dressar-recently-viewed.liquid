{%- comment -%}
  Recently viewed.

  The list lives in the shopper's own browser — no account, nothing sent anywhere,
  nothing that needs a consent banner entry beyond what localStorage already implies.

  Rendering it needs products the server does not know about, so this section is
  fetched back through the search endpoint with an id query:

    /search?section_id=dressar-recently-viewed&type=product&q=id:1 OR id:2

  That is Shopify's own mechanism for exactly this, which is why no product data is
  duplicated anywhere and no app is required. When the section is rendered normally
  on a product page, `search.performed` is false and it emits only the empty shell
  for the script to fill.

  The shell stays hidden until there is something in it, so a first-time visitor
  never sees a "Recently viewed" heading over nothing.
{%- endcomment -%}

{{ 'dressar-sections.css' | asset_url | stylesheet_tag }}
{{ 'dressar-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dressar-card.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'dressar-recently-viewed.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
-%}

{%- if search.performed -%}
  {%- comment -%}
    The fetched pass. Only products are wanted, and the current product is excluded by
    the script when it builds the query rather than here, so this stays a plain list.
  {%- endcomment -%}
  {%- assign found = search.results | where: 'object_type', 'product' -%}
  {%- if found.size > 0 -%}
    {% render 'dressar-product-rail',
      items: found,
      ratio: s.image_ratio,
      meta_source: s.meta_source,
      columns: s.columns_desktop,
      mobile_columns: s.columns_mobile,
      show_swatches: s.show_swatches,
      swatch_limit: 4
    %}
  {%- endif -%}

{%- else -%}
  <div
    class="dr-section dr-rec color-{{ s.color_scheme }} gradient"
    style="--dr-pt: {{ s.padding_top }}px; --dr-pb: {{ s.padding_bottom }}px;"
    data-dr-recent
    data-section-id="{{ section.id }}"
    data-limit="{{ s.products_to_show }}"
    {% if product %}data-current="{{ product.id }}"{% endif %}
    hidden
  >
    {%- if s.heading != blank -%}
      <div class="dr-wrap dr-head"><h2 class="dr-head__title">{{ s.heading }}</h2></div>
    {%- endif -%}
    <div data-dr-recent-body></div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Recently viewed",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Remembered in the shopper's own browser. No account needed, and nothing is sent anywhere. The section stays hidden until they have viewed something." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 6, "step": 1, "label": "Products to show", "default": 6 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 6, "step": 1, "label": "Columns on desktop", "default": 6 },
    {
      "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "default": "2",
      "options": [{ "value": "1", "label": "One" }, { "value": "2", "label": "Two" }]
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "portrait",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "45", "label": "Portrait (4:5)" },
        { "value": "natural", "label": "Natural — no crop" }
      ]
    },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour swatches", "default": false },
    {
      "type": "select", "id": "meta_source", "label": "Line above the title", "default": "none",
      "options": [
        { "value": "none", "label": "Nothing" },
        { "value": "type", "label": "Product type" },
        { "value": "fabric", "label": "Fabric metafield" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ]
}
{% endschema %}
