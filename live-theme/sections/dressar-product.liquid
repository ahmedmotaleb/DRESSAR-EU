{%- comment -%}
  Product page. Gallery 60 / information 40 on desktop, information sticky.
  Add-to-cart submission is handled by Dawn's <product-form> element so the
  existing cart drawer, error handling and analytics keep working.
{%- endcomment -%}

{{ 'dressar-sections.css' | asset_url | stylesheet_tag }}
{{ 'dressar-card.css' | asset_url | stylesheet_tag }}
{{ 'dressar-product.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  dressar-card.css is here for the colour swatches, which are the same component the
  grid uses — the shopper should not meet two different swatch designs on one visit.
{%- endcomment -%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'dressar-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign v = product.selected_or_first_available_variant
  assign form_id = 'DressarProductForm-' | append: section.id
-%}

<product-component
  view-event-payload="{{ product | standard_event_data: 'view' | escape }}"
  data-product-id="{{ product.id }}"
>
<section
  class="dr-section color-{{ s.color_scheme }} gradient"
  style="--dr-pt: {{ s.padding_top }}px; --dr-pb: {{ s.padding_bottom }}px;"
  data-dr-product
  data-money-format="{{ shop.money_format | escape }}"
>
  <div class="dr-wrap">
    {%- if s.show_breadcrumb -%}
      <nav class="dr-pdp__crumb" aria-label="Breadcrumbs">
        <a href="{{ routes.root_url }}">{{ shop.name }}</a>
        <span aria-hidden="true">/</span>
        {%- if collection -%}
          <a href="{{ collection.url }}">{{ collection.title }}</a>
          <span aria-hidden="true">/</span>
        {%- endif -%}
        <span>{{ product.title }}</span>
      </nav>
    {%- endif -%}

    <div class="dr-pdp">
      <div class="dr-pdp__media">
      {%- comment -%}
        The counter is only meaningful while the gallery is a swipeable strip, which is
        the mobile layout; CSS hides it once the editorial grid shows every image at
        once, where counting them would say nothing.
      {%- endcomment -%}
      {%- if product.media.size > 1 -%}
        <p class="dr-pdp__counter" data-dr-counter aria-hidden="true">
          <span data-dr-counter-now>1</span> / {{ product.media.size }}
        </p>
      {%- endif -%}
      <div class="dr-pdp__gallery dr-pdp__gallery--{{ s.gallery_layout }}" data-dr-gallery aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
        {%- for media in product.media -%}
          <figure class="dr-pdp__figure" data-media-id="{{ media.id }}" data-dr-figure>
            {%- if media.media_type == 'image' -%}
              <button
                type="button"
                class="dr-pdp__zoom"
                data-dr-zoom="{{ forloop.index0 }}"
                aria-label="{{ 'products.product.media.open_media' | t: index: forloop.index }}"
              >
              <img
                src="{{ media | image_url: width: 1400 }}"
                srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1400 }} 1400w"
                sizes="(min-width: 990px) 55vw, 100vw"
                alt="{{ media.alt | default: product.title | escape }}"
                width="{{ media.width }}"
                height="{{ media.height }}"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
              >
              </button>
            {%- else -%}
              {{ media | media_tag: image_size: '1400x', autoplay: false, loop: false, controls: true }}
            {%- endif -%}
          </figure>
        {%- else -%}
          <figure class="dr-pdp__figure">{{ 'product-1' | placeholder_svg_tag: '' }}</figure>
        {%- endfor -%}
      </div>
      </div>

      <div class="dr-pdp__info">
        {%- if s.eyebrow_source == 'collection' and product.collections.first -%}
          <p class="dr-pdp__eyebrow">{{ product.collections.first.title }}</p>
        {%- elsif s.eyebrow_source == 'type' and product.type != blank -%}
          <p class="dr-pdp__eyebrow">{{ product.type }}</p>
        {%- endif -%}

        <h1 class="dr-pdp__title">{{ product.title }}</h1>

        {%- assign subtitle = product.metafields.custom.subtitle.value -%}
        {%- if subtitle != blank -%}
          <p class="dr-pdp__subtitle">{{ subtitle }}</p>
        {%- endif -%}

        <div class="dr-pdp__price" data-dr-price>
          {%- if v.compare_at_price > v.price -%}
            <span class="dr-pdp__price-now">{{ v.price | money }}</span>
            <s class="dr-pdp__price-was">{{ v.compare_at_price | money }}</s>
          {%- else -%}
            <span class="dr-pdp__price-now">{{ v.price | money }}</span>
          {%- endif -%}
        </div>

        <p class="dr-pdp__tax">
          {%- if cart.taxes_included -%}{{ 'products.product.taxes_included' | t }} {% endif -%}
          {%- if shop.shipping_policy.body != blank -%}
            {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
          {%- endif -%}
        </p>

        {%- if s.show_colours -%}
          {%- comment -%}
            The same colour component the grid uses, so a shopper meets one swatch
            design across the whole store. It resolves native colour variants and
            sibling products in a Product Family identically, and renders nothing when
            the product has neither — which is every product here until families are
            set up in admin.
          {%- endcomment -%}
          <div class="dr-pdp__colours">
            <p class="dr-pdp__opt-label">
              <span>{{ s.colour_label }}</span>
            </p>
            {% render 'dressar-colours',
              product: product,
              output: 'label',
              colour_word: s.colour_word,
              colour_label: s.colour_label
            %}
            {%- comment -%} limit 0 shows every colour: there is room here, unlike a card. {%- endcomment -%}
            {% render 'dressar-colours',
              product: product,
              output: 'swatches',
              limit: 0,
              colour_word: s.colour_word,
              colour_label: s.colour_label
            %}
          </div>
        {%- endif -%}

        {%- comment -%}
          <product-form> must WRAP the form, not sit inside it: Dawn's element does
          `this.form = this.querySelector('form')`, a descendant lookup, then
          immediately dereferences it. With the form as an ancestor that is null and
          the element throws on connect, losing the AJAX add and the cart drawer.
        {%- endcomment -%}
        <product-form class="product-form" data-hide-errors="false" data-section-id="{{ section.id }}">
        {%- form 'product',
          product,
          id: form_id,
          class: 'dr-pdp__form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}
          <input type="hidden" name="id" value="{{ v.id }}" data-dr-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- liquid
                assign is_size = false
                assign lower = option.name | downcase
                if lower contains 'size'
                  assign is_size = true
                endif
              -%}
              <fieldset
                class="dr-opt"
                data-dr-option-group
                data-option-name="{{ option.name | escape }}"
              >
                <legend class="dr-opt__legend">
                  <span>{{ option.name }}</span>
                  <span class="dr-opt__value" data-dr-option-value>{{ option.selected_value }}</span>
                  {%- comment -%}
                    The drawer wins when the product has a size chart, because it keeps
                    the shopper on the page. The page link stays as the fallback for
                    products with no chart yet. When neither exists nothing renders —
                    a Size guide link that opens an empty drawer is worse than none.
                  {%- endcomment -%}
                  {%- if is_size and product.metafields.custom.size_chart.value != blank -%}
                    <button type="button" class="dr-opt__guide" data-dr-guide-open>
                      {{- s.size_guide_label -}}
                    </button>
                  {%- elsif is_size and s.size_guide_page != blank -%}
                    <a class="dr-opt__guide" href="{{ s.size_guide_page.url }}">{{ s.size_guide_label }}</a>
                  {%- endif -%}
                </legend>

                <div class="dr-opt__choices">
                  {%- for value in option.values -%}
                    {%- assign input_id = 'opt-' | append: section.id | append: '-' | append: forloop.parentloop.index | append: '-' | append: forloop.index -%}
                    <span class="dr-opt__choice">
                      <input
                        type="radio"
                        id="{{ input_id }}"
                        name="option{{ forloop.parentloop.index }}"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value and s.preselect %}checked{% endif %}
                      >
                      <label for="{{ input_id }}">{{ value }}</label>
                    </span>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          {%- comment -%}
            Length sits here, immediately under the size choice, rather than in the
            accordions. For a maxi skirt or a coat it is the measurement that decides
            the purchase, and buried in a description nobody finds it.
          {%- endcomment -%}
          {% render 'dressar-product-details',
            product: product,
            output: 'length',
            length_label: s.length_label
          %}

          <p
            class="dr-pdp__stock"
            data-dr-stock
            data-template="{{ 'products.product.inventory_low_stock_show_count' | t: quantity: '[count]' }}"
            {% unless v.available and v.inventory_management != blank and v.inventory_quantity > 0 and v.inventory_quantity <= 3 %}hidden{% endunless %}
          >
            {{ 'products.product.inventory_low_stock_show_count' | t: quantity: v.inventory_quantity }}
          </p>

          <p
            class="dr-pdp__error"
            data-dr-size-error
            data-template="{{ s.validation_message | escape }}"
            role="alert"
            hidden
          ></p>

          <div class="product-form__error-message-wrapper" role="alert" hidden>
            <span class="product-form__error-message"></span>
          </div>

          <div class="dr-pdp__buy" data-dr-sticky-anchor>
            <button
              id="ProductSubmitButton-{{ section.id }}"
              type="submit"
              name="add"
              class="dr-btn dr-btn--solid dr-btn--full product-form__submit"
              data-dr-submit
              data-text-add="{{ 'products.product.add_to_cart' | t | escape }}"
              data-text-soldout="{{ 'products.product.sold_out' | t | escape }}"
              data-text-unavailable="{{ 'products.product.unavailable' | t | escape }}"
              {% unless v.available %}disabled{% endunless %}
            >
              <span>
                {%- if v.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
              {%- comment -%}
                Required, not decoration: Dawn's onSubmitHandler calls
                preventDefault and then querySelector('.loading__spinner').classList.
                With no such node it throws after the default was already
                suppressed, so the form neither submits nor adds anything.
              {%- endcomment -%}
              <div class="loading__spinner hidden">
                <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                </svg>
              </div>
            </button>

            {%- if s.show_dynamic_checkout -%}
            {{ form | payment_button }}
            {%- endif -%}
          </div>
        {%- endform -%}
        </product-form>

        {%- if s.delivery_note != blank -%}
          <p class="dr-pdp__delivery">{{ s.delivery_note }}</p>
        {%- endif -%}

        {% render 'dressar-product-details',
          product: product,
          heading: s.details_heading,
          length_label: s.length_label,
          model_label: s.model_label,
          model_wears_label: s.model_wears_label,
          advice_label: s.advice_label
        %}

        <div class="dr-acc">
          {%- if product.description != blank -%}
            <details class="dr-acc__item" open>
              <summary class="dr-acc__head">
                <span>{{ 'products.product.description' | t }}</span>
                <span class="dr-acc__sign" aria-hidden="true"></span>
              </summary>
              <div class="dr-acc__body rte">{{ product.description }}</div>
            </details>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'metafield_row' -%}
                {%- assign mf = product.metafields.custom[block.settings.key] -%}
                {%- if mf.value != blank -%}
                  <details class="dr-acc__item" {{ block.shopify_attributes }}>
                    <summary class="dr-acc__head">
                      <span>{{ block.settings.heading }}</span>
                      <span class="dr-acc__sign" aria-hidden="true"></span>
                    </summary>
                    {%- comment -%}
                      metafield_tag, not the raw value: a rich_text_field stores a
                      JSON document, so printing .value would dump the structure
                      rather than the text. metafield_tag renders every type
                      correctly, which matters because the key is merchant-set.
                    {%- endcomment -%}
                    <div class="dr-acc__body rte">{{ mf | metafield_tag }}</div>
                  </details>
                {%- endif -%}
              {%- when 'text_row' -%}
                {%- if block.settings.content != blank -%}
                  <details class="dr-acc__item" {{ block.shopify_attributes }}>
                    <summary class="dr-acc__head">
                      <span>{{ block.settings.heading }}</span>
                      <span class="dr-acc__sign" aria-hidden="true"></span>
                    </summary>
                    <div class="dr-acc__body rte">{{ block.settings.content }}</div>
                  </details>
                {%- endif -%}
              {%- when 'page_row' -%}
                {%- if block.settings.page != blank -%}
                  <details class="dr-acc__item" {{ block.shopify_attributes }}>
                    <summary class="dr-acc__head">
                      <span>{{ block.settings.heading }}</span>
                      <span class="dr-acc__sign" aria-hidden="true"></span>
                    </summary>
                    <div class="dr-acc__body rte">{{ block.settings.page.content }}</div>
                  </details>
                {%- endif -%}
              {%- when 'eu_info' -%}
                {% render 'dressar-eu-info', product: product, heading: block.settings.heading, block: block %}
            {%- endcase -%}
          {%- endfor -%}
        </div>

        {%- if v.sku != blank -%}
          <p class="dr-pdp__sku">
            {{ 'products.product.sku' | t }}: <span data-dr-sku>{{ v.sku }}</span>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-dr-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 }},
          "available": {{ variant.available | json }},
          "sku": {{ variant.sku | json }},
          "inventory_management": {{ variant.inventory_management | json }},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 }},
          "featured_media_id": {{ variant.featured_media.id | default: 0 }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>
</product-component>

{%- comment -%}
  Product structured data. Replacing Dawn's main-product.liquid dropped the JSON-LD
  it emitted, which costs price and availability in Google's product rich results.
  Every value is read from the product — nothing is asserted that the store has not
  actually set.
{%- endcomment -%}
{%- liquid
  assign seo_media = product.featured_media
  assign seo_variant = product.selected_or_first_available_variant
-%}
<script type="application/ld+json">
{
  "@context": "http://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {% if seo_media %}
    "image": [{{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}],
  {% endif %}
  {% if product.description != blank %}
    "description": {{ product.description | strip_html | json }},
  {% endif %}
  {% if seo_variant.sku != blank %}
    "sku": {{ seo_variant.sku | json }},
  {% endif %}
  {% if product.vendor != blank %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
  {% endif %}
  "offers": [
    {% for variant in product.variants %}
      {
        "@type": "Offer",
        {% if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
        "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "price": {{ variant.price | divided_by: 100.00 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "url": {{ request.origin | append: variant.url | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>

{%- if s.enable_sticky_bar -%}
  {%- comment -%}
    A real submit, not a jump link. It targets the actual form, so with a size already
    chosen it adds straight to the bag; with none chosen the existing submit guard
    stops it, names the missing option and moves focus to the size grid.

    Deliberately not a duplicate size picker in the bar. A second set of radios sharing
    the name of the real ones would both post, and the browser would keep whichever
    came last — so the shopper could see M selected in the bar and get L in the bag.
  {%- endcomment -%}
  <div class="dr-stickybar" data-dr-sticky>
    <span class="dr-stickybar__title">{{ product.title }}</span>
    <span class="dr-stickybar__price" data-dr-sticky-price>{{ v.price | money }}</span>
    <button
      type="button"
      class="dr-btn dr-btn--solid"
      data-dr-sticky-add
      data-form="{{ form_id }}"
    >
      <span>{{ 'products.product.add_to_cart' | t }}</span>
    </button>
  </div>
{%- endif -%}

{% render 'dressar-size-guide',
  product: product,
  trigger_label: s.size_guide_label,
  close_label: s.close_label,
  cm_label: s.cm_label,
  in_label: s.in_label,
  how_label: s.how_label,
  body_label: s.body_label,
  garment_label: s.garment_label,
  notes_label: s.notes_label
%}

{%- comment -%}
  One overlay for the whole page. The gallery fills it with whichever image was
  tapped, so there is no second copy of every photograph in the markup.
{%- endcomment -%}
<div class="dr-zoom" data-dr-zoom-overlay hidden>
  <button
    type="button"
    class="dr-zoom__close"
    data-dr-zoom-close
    aria-label="{{ s.close_label | escape }}"
  >
    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.4" fill="none"/>
    </svg>
  </button>
  <img alt="" data-dr-zoom-image>
</div>

{% schema %}
{
  "name": "Product",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    {
      "type": "select", "id": "eyebrow_source", "label": "Line above the title", "default": "collection",
      "options": [
        { "value": "none", "label": "Nothing" },
        { "value": "collection", "label": "First collection" },
        { "value": "type", "label": "Product type" }
      ]
    },
    {
      "type": "select", "id": "gallery_layout", "label": "Gallery", "default": "grid",
      "options": [
        { "value": "grid", "label": "Editorial grid" },
        { "value": "stack", "label": "Single column" }
      ]
    },
    { "type": "header", "content": "Colours" },
    { "type": "checkbox", "id": "show_colours", "label": "Show colour swatches", "info": "Shows every colour of the style, whether they are variants or separate products in a Product Family.", "default": true },
    { "type": "text", "id": "colour_label", "label": "Colour label", "default": "Colour" },
    { "type": "text", "id": "colour_word", "label": "Word for the colour count", "default": "colours" },
    { "type": "header", "content": "Fit and details" },
    { "type": "text", "id": "details_heading", "label": "Heading", "default": "Fit & details" },
    { "type": "text", "id": "length_label", "label": "Garment length label", "info": "Shown directly under the size choice, where it decides the purchase.", "default": "Garment length" },
    { "type": "text", "id": "model_label", "label": "Model height label", "default": "Model" },
    { "type": "text", "id": "model_wears_label", "label": "Model size label", "default": "Model wears" },
    { "type": "text", "id": "advice_label", "label": "Sizing advice label", "default": "Sizing" },
    { "type": "header", "content": "Size guide" },
    { "type": "text", "id": "cm_label", "label": "Centimetres label", "default": "cm" },
    { "type": "text", "id": "in_label", "label": "Inches label", "default": "in" },
    { "type": "text", "id": "how_label", "label": "How to measure heading", "default": "How to measure" },
    { "type": "text", "id": "body_label", "label": "Body measurements heading", "default": "Body measurements" },
    { "type": "text", "id": "garment_label", "label": "Garment measurements heading", "default": "Garment measurements" },
    { "type": "text", "id": "notes_label", "label": "Fit notes heading", "default": "Fit notes" },
    { "type": "text", "id": "close_label", "label": "Close control label", "info": "Read out by screen readers on the size guide and the enlarged image.", "default": "Close" },
    { "type": "header", "content": "Buying" },
    { "type": "checkbox", "id": "preselect", "label": "Pre-select the first option", "info": "Leave off so the customer must choose a size deliberately.", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show express payment buttons", "default": true },
    { "type": "text", "id": "validation_message", "label": "Message when no option is chosen", "default": "Please choose a [option]." },
    { "type": "page", "id": "size_guide_page", "label": "Size guide page" },
    { "type": "text", "id": "size_guide_label", "label": "Size guide link label", "default": "Size guide" },
    { "type": "textarea", "id": "delivery_note", "label": "Delivery and returns note", "default": "Delivered across the EU. 14-day right of withdrawal on every order." },
    { "type": "checkbox", "id": "enable_sticky_bar", "label": "Sticky bar on mobile", "info": "Appears once the main button scrolls out of view.", "default": true },
    { "type": "header", "content": "Section" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "metafield_row",
      "name": "Metafield accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fabric & composition" },
        { "type": "text", "id": "key", "label": "Metafield key", "info": "Under the custom namespace, e.g. fabric_composition. The row is hidden when the product has no value.", "default": "fabric_composition" }
      ]
    },
    {
      "type": "text_row",
      "name": "Text accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery & returns" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    },
    {
      "type": "page_row",
      "name": "Page accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Care" },
        { "type": "page", "id": "page", "label": "Page" }
      ]
    },
    {
      "type": "eu_info",
      "name": "EU product information",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Shows manufacturer and EU responsible person details from product metafields. Each line appears only when that product has a value — nothing is invented." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Product information" }
      ]
    }
  ]
