{{ 'dressar-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign img = collection.image
  assign use_image = false
  if s.show_image and img
    assign use_image = true
  endif
-%}

<section class="dr-collhead dr-collhead--{% if use_image %}image{% else %}plain{% endif %} color-{{ s.color_scheme }} gradient">
  {%- if use_image -%}
    <div class="dr-collhead__media">
      <img
        src="{{ img | image_url: width: 2000 }}"
        srcset="{{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ img.alt | default: collection.title | escape }}"
        width="{{ img.width }}"
        height="{{ img.height }}"
        fetchpriority="high"
      >
      {%- if s.overlay_opacity > 0 -%}
        <span class="dr-collhead__scrim" style="background: rgba(0,0,0,{{ s.overlay_opacity | divided_by: 100.0 }});"></span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="dr-collhead__inner dr-wrap"{% if use_image %} style="color: {{ s.text_colour }};"{% endif %}>
    {%- if s.show_breadcrumb -%}
      <nav class="dr-collhead__crumb" aria-label="{{ 'general.breadcrumbs.label' | t | default: 'Breadcrumbs' }}">
        <a href="{{ routes.root_url }}">{{ shop.name }}</a>
        <span aria-hidden="true">/</span>
        <span>{{ collection.title }}</span>
      </nav>
    {%- endif -%}

    <h1 class="dr-collhead__title">{{ collection.title }}</h1>

    {%- if s.show_description and collection.description != blank -%}
      <div class="dr-collhead__text rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.dr-collhead { position: relative; display: grid; }
.dr-collhead--plain { padding-block: 5.6rem 3.2rem; }
.dr-collhead--image .dr-collhead__media,
.dr-collhead--image .dr-collhead__inner { grid-area: 1 / 1; }
.dr-collhead__media { position: relative; overflow: hidden; min-height: 34vh; display: grid; }
.dr-collhead__media img { width: 100%; height: 100%; object-fit: cover; grid-area: 1 / 1; }
.dr-collhead__scrim { position: absolute; inset: 0; }
.dr-collhead__inner {
  position: relative;
  z-index: 2;
  text-align: center;
  align-self: center;
  padding-block: 4rem;
}
.dr-collhead--plain .dr-collhead__inner { padding-block: 0; }
.dr-collhead__crumb {
  font-size: 1.2rem;
  letter-spacing: .1em;
  text-transform: uppercase;
  opacity: .6;
  margin-bottom: 1.2rem;
  display: flex;
  gap: .8rem;
  justify-content: center;
}
.dr-collhead__crumb a { color: inherit; text-decoration: none; }
.dr-collhead__crumb a:hover { text-decoration: underline; text-underline-offset: .3rem; }
.dr-collhead__title {
  font-family: var(--font-heading-family);
  font-weight: var(--font-heading-weight);
  font-size: clamp(2.8rem, 2.2rem + 2vw, 4.8rem);
  letter-spacing: .02em;
  margin: 0;
  text-wrap: balance;
}
.dr-collhead__text { margin: 1.6rem auto 0; max-width: 62ch; opacity: .78; }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection header",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show collection image as a banner", "default": false },
    { "type": "color", "id": "text_colour", "label": "Text colour over image", "default": "#FFFFFF" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Image darkening", "default": 25 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
