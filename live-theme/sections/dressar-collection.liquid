{%- comment -%}
  Collection grid.

  Deliberately keeps Dawn's filtering plumbing intact: the <collection-component>
  wrapper, the paginate block, the facets aside, and the #ProductGridContainer /
  #product-grid ids that facets.js swaps on every filter change. Only the card
  and the grid classes are ours.
{%- endcomment -%}

{{ 'dressar-sections.css' | asset_url | stylesheet_tag }}
{{ 'dressar-card.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- comment -%}
  Card assets are loaded once here by the section, not inside the card snippet, which
  would emit the same <link> twenty-four times in a full grid.
{%- endcomment -%}
<script src="{{ 'dressar-card.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
-%}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div
    class="dr-section color-{{ s.color_scheme }} gradient"
    style="--dr-pt: {{ s.padding_top }}px; --dr-pb: {{ s.padding_bottom }}px;"
  >
    {%- paginate collection.products by s.products_per_page -%}
      {%- if s.enable_filtering or s.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper page-width{% unless s.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: s.enable_filtering,
            enable_sorting: s.enable_sorting,
            filter_type: s.filter_type,
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      <div class="product-grid-container" id="ProductGridContainer">
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="dr-empty">
              <p class="dr-empty__title">{{ 'sections.collection_template.empty' | t }}</p>
              <p class="dr-empty__text">
                {{-
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'dr-head__cta'
                -}}
              </p>
            </div>
          </div>
        {%- else -%}
          <div class="collection">
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="dr-wrap dr-wrap--shop dr-grid dr-grid--collection"
              style="--dr-cols: {{ s.columns_desktop }}; --dr-cols-tablet: {{ s.columns_tablet }}; --dr-cols-mobile: {{ s.columns_mobile }};"
            >
              {%- for product in collection.products -%}
                {%- assign card_uid = section.id | append: '-' | append: forloop.index -%}
                <li>
                  {% render 'dressar-card',
                    card_product: product,
                    ratio: s.image_ratio,
                    fit: s.image_fit,
                    show_second: s.show_secondary_image,
                    meta_source: s.meta_source,
                    index: forloop.index,
                    quick_add: s.quick_add,
                    show_swatches: s.show_swatches,
                    swatch_limit: s.swatch_limit,
                    show_wishlist: s.show_wishlist,
                    show_discount: s.show_discount,
                    wishlist_label: s.wishlist_label,
                    colour_word: s.colour_word,
                    colour_label: s.colour_label,
                    uid: card_uid
                  %}
                </li>
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              <div class="dr-wrap">
                {% render 'pagination', paginate: paginate, anchor: '' %}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endpaginate -%}
  </div>
</collection-component>

{% stylesheet %}
/* Padding and columns both come from dressar-sections.css now. They used to be
   repeated here, which meant the section stylesheet and the linked asset set the
   same properties at equal specificity — whichever loaded second won, and that
   order is not guaranteed. */
.dr-grid--collection { list-style: none; margin: 0; }
.dr-grid--collection > li { min-width: 0; }
.dr-empty { text-align: center; padding-block: 8rem; }
.dr-empty__title {
  font-family: var(--font-heading-family);
  font-size: clamp(2rem, 1.7rem + 1vw, 2.8rem);
  margin: 0 0 1rem;
}
.dr-empty__text { opacity: .72; margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection grid",
  "class": "section",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 36, "step": 4, "label": "Products per page", "default": 24 },
    { "type": "range", "id": "columns_desktop", "min": 3, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "range", "id": "columns_tablet", "min": 2, "max": 4, "step": 1, "label": "Columns on tablet", "default": 3 },
    {
      "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "default": "2",
      "options": [{ "value": "1", "label": "One" }, { "value": "2", "label": "Two" }]
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "portrait",
      "info": "Dressar sells long garments. Taller crops cut off hemlines.",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "45", "label": "Portrait (4:5)" },
        { "value": "natural", "label": "Natural — no crop" }
      ]
    },
    {
      "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover",
      "info": "Full garment shows the whole photograph, including the hem, on a neutral ground.",
      "options": [
        { "value": "cover", "label": "Cover — fills the frame" },
        { "value": "contain", "label": "Full garment — nothing cropped" }
      ]
    },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Second image on hover", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour swatches", "default": true },
    { "type": "range", "id": "swatch_limit", "min": 3, "max": 6, "step": 1, "label": "Swatches before “+n”", "default": 4 },
    { "type": "text", "id": "colour_word", "label": "Word for the colour count", "info": "Shown as “Black · 4 colours”.", "default": "colours" },
    { "type": "text", "id": "colour_label", "label": "Swatch group label", "info": "Read out by screen readers before the swatches.", "default": "Colour" },
    { "type": "header", "content": "Card extras" },
    { "type": "checkbox", "id": "show_discount", "label": "Show discount percentage", "default": false },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show save control", "info": "Requires a wishlist app. On its own the control stores nothing, so leave it off until an app is installed.", "default": false },
    { "type": "text", "id": "wishlist_label", "label": "Save control label", "default": "Save" },
    { "type": "checkbox", "id": "quick_add", "label": "Quick add", "info": "Adds a size picker to each card so shoppers can add to the bag without leaving the grid.", "default": true },
    {
      "type": "select", "id": "meta_source", "label": "Line above the title", "default": "type",
      "options": [
        { "value": "none", "label": "Nothing" },
        { "value": "type", "label": "Product type" },
        { "value": "fabric", "label": "Fabric metafield" }
      ]
    },
    { "type": "header", "content": "Filtering" },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "info": "Filters come from the Search & Discovery app.", "default": true },
    {
      "type": "select", "id": "filter_type", "label": "Filter layout", "default": "drawer",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Sidebar" },
        { "value": "drawer", "label": "Drawer" }
      ]
    },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },
    { "type": "header", "content": "Section" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ]
}
{% endschema %}
