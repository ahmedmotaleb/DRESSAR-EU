{%- comment -%}
  Collection grid.

  Deliberately keeps Dawn's filtering plumbing intact: the <collection-component>
  wrapper, the paginate block, the facets aside, and the #ProductGridContainer /
  #product-grid ids that facets.js swaps on every filter change. Only the card
  and the grid classes are ours.
{%- endcomment -%}

{{ 'dressar-sections.css' | asset_url | stylesheet_tag }}
{{ 'dressar-card.css' | asset_url | stylesheet_tag }}
{{ 'dressar-shop.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- comment -%}
  Card assets are loaded once here by the section, not inside the card snippet, which
  would emit the same <link> twenty-four times in a full grid.
{%- endcomment -%}
<script src="{{ 'dressar-card.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'dressar-grid.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
-%}

{%- if s.quick_add -%}
  {{ 'dressar-quick-add.css' | asset_url | stylesheet_tag }}
  {%- comment -%}
    Dawn's product-form.js must be present on THIS page, not in the fetched markup:
    a <script> arriving through innerHTML never executes, so the custom element has
    to already be defined when the quick-add payload is injected.
  {%- endcomment -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'dressar-quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  {%- comment -%}
    The column counts live here, not on the <ul>. facets.js replaces
    #ProductGridContainer wholesale on every filter change, so a custom property set
    inside it would be discarded the first time anyone touched a filter — taking the
    shopper's density choice with it. This wrapper survives, and custom properties
    inherit down to the grid regardless.
  {%- endcomment -%}
  <div
    class="dr-section color-{{ s.color_scheme }} gradient"
    data-dr-grid-scope
    style="--dr-pt: {{ s.padding_top }}px; --dr-pb: {{ s.padding_bottom }}px; --dr-cols: {{ s.columns_desktop }}; --dr-cols-tablet: {{ s.columns_tablet }}; --dr-cols-mobile: {{ s.columns_mobile }};"
  >
    {%- paginate collection.products by s.products_per_page -%}
      {%- if s.enable_filtering or s.enable_sorting -%}
        {%- comment -%}
          aria-labelledby used to point at #verticalTitle, which only exists in the
          sidebar layout — in drawer mode it referenced nothing, leaving this landmark
          with no accessible name at all. A dangling reference is worse than none,
          because it looks correct in the markup.
        {%- endcomment -%}
        <aside
          aria-label="{{ s.toolbar_label | escape }}"
          class="facets-wrapper dr-wrap dr-wrap--shop dr-toolbar{% if s.sticky_toolbar %} dr-toolbar--sticky{% endif %}{% unless s.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: s.enable_filtering,
            enable_sorting: s.enable_sorting,
            filter_type: s.filter_type,
            paginate: paginate
          %}

          {%- if s.show_density -%}
            {% render 'dressar-grid-density',
              label: s.density_label,
              desktop: s.columns_desktop,
              mobile: s.columns_mobile
            %}
          {%- endif -%}
        </aside>
      {%- endif -%}

      <div class="product-grid-container" id="ProductGridContainer">
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="dr-empty">
              <p class="dr-empty__title">{{ 'sections.collection_template.empty' | t }}</p>
              <p class="dr-empty__text">
                {{-
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'dr-head__cta'
                -}}
              </p>
            </div>
          </div>
        {%- else -%}
          <div class="collection">
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="dr-wrap dr-wrap--shop dr-grid dr-grid--collection"
            >
              {%- for product in collection.products -%}
                {%- assign card_uid = section.id | append: '-' | append: forloop.index -%}
                <li>
                  {% render 'dressar-card',
                    card_product: product,
                    ratio: s.image_ratio,
                    fit: s.image_fit,
                    show_second: s.show_secondary_image,
                    meta_source: s.meta_source,
                    index: forloop.index,
                    quick_add: s.quick_add,
                    show_swatches: s.show_swatches,
                    swatch_limit: s.swatch_limit,
                    show_wishlist: s.show_wishlist,
                    show_discount: s.show_discount,
                    wishlist_label: s.wishlist_label,
                    colour_word: s.colour_word,
                    colour_label: s.colour_label,
                    uid: card_uid
                  %}
                </li>

                {%- comment -%}
                  Editorial cards are emitted from inside the product loop, so one can
                  only appear if the grid actually reached that position. A filter that
                  cuts the results to six products silently drops the card scheduled
                  after the twelfth, instead of leaving it stranded at the end.
                {%- endcomment -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'editorial' and block.settings.after_product == forloop.parentloop.index -%}
                    {%- liquid
                      assign b = block.settings
                      assign has_link = false
                      if b.link != blank
                        assign has_link = true
                      endif
                    -%}
                    <li
                      class="dr-editorial dr-editorial--{{ b.span }}{% if b.overlay %} dr-editorial--overlay{% endif %}"
                      style="--dr-editorial-text: {{ b.text_colour }}; --dr-editorial-scrim: {{ b.scrim | divided_by: 100.0 }};"
                      {{ block.shopify_attributes }}
                    >
                      <div class="dr-editorial__media">
                        {%- if b.image -%}
                          <img
                            src="{{ b.image | image_url: width: 1400 }}"
                            srcset="{{ b.image | image_url: width: 700 }} 700w, {{ b.image | image_url: width: 1400 }} 1400w"
                            sizes="(min-width: 990px) 50vw, 100vw"
                            alt="{{ b.image.alt | escape }}"
                            width="{{ b.image.width }}"
                            height="{{ b.image.height }}"
                            loading="lazy"
                          >
                        {%- else -%}
                          {{ 'lifestyle-1' | placeholder_svg_tag: '' }}
                        {%- endif -%}
                      </div>

                      <div class="dr-editorial__body">
                        {%- if b.eyebrow != blank -%}
                          <p class="dr-editorial__eyebrow">{{ b.eyebrow }}</p>
                        {%- endif -%}
                        {%- if b.heading != blank -%}
                          <h3 class="dr-editorial__title">{{ b.heading }}</h3>
                        {%- endif -%}
                        {%- if b.text != blank -%}
                          <p class="dr-editorial__text">{{ b.text }}</p>
                        {%- endif -%}
                        {%- comment -%}
                          Only a link when there is somewhere to go. An empty href
                          resolves to the current page, so an unconfigured card would
                          silently reload the collection and read as a broken site.
                        {%- endcomment -%}
                        {%- if b.cta != blank and has_link -%}
                          <a class="dr-editorial__cta" href="{{ b.link }}">{{ b.cta }}</a>
                        {%- elsif b.cta != blank -%}
                          <span class="dr-editorial__cta">{{ b.cta }}</span>
                        {%- endif -%}
                      </div>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              <div class="dr-wrap">
                {% render 'pagination', paginate: paginate, anchor: '' %}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endpaginate -%}
  </div>
</collection-component>

{%- if s.quick_add -%}
  {%- comment -%}
    One sheet for the whole page, outside #ProductGridContainer so that filtering —
    which replaces that container wholesale — cannot tear it out mid-interaction.
  {%- endcomment -%}
  {% render 'dressar-quick-add-sheet',
    heading: s.quick_add_heading,
    add_label: s.quick_add_label,
    error_message: s.quick_add_error,
    close_label: s.quick_add_close,
    dialog_label: s.quick_add_dialog
  %}
{%- endif -%}

{% stylesheet %}
/* Padding and columns both come from dressar-sections.css now. They used to be
   repeated here, which meant the section stylesheet and the linked asset set the
   same properties at equal specificity — whichever loaded second won, and that
   order is not guaranteed. */
.dr-grid--collection { list-style: none; margin: 0; }
.dr-grid--collection > li { min-width: 0; }
.dr-empty { text-align: center; padding-block: 8rem; }
.dr-empty__title {
  font-family: var(--font-heading-family);
  font-size: clamp(2rem, 1.7rem + 1vw, 2.8rem);
  margin: 0 0 1rem;
}
.dr-empty__text { opacity: .72; margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection grid",
  "class": "section",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 36, "step": 4, "label": "Products per page", "default": 24 },
    { "type": "range", "id": "columns_desktop", "min": 3, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "range", "id": "columns_tablet", "min": 2, "max": 4, "step": 1, "label": "Columns on tablet", "default": 3 },
    {
      "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "default": "2",
      "options": [{ "value": "1", "label": "One" }, { "value": "2", "label": "Two" }]
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "portrait",
      "info": "Dressar sells long garments. Taller crops cut off hemlines.",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "45", "label": "Portrait (4:5)" },
        { "value": "natural", "label": "Natural — no crop" }
      ]
    },
    {
      "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover",
      "info": "Full garment shows the whole photograph, including the hem, on a neutral ground.",
      "options": [
        { "value": "cover", "label": "Cover — fills the frame" },
        { "value": "contain", "label": "Full garment — nothing cropped" }
      ]
    },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Second image on hover", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour swatches", "default": true },
    { "type": "range", "id": "swatch_limit", "min": 3, "max": 6, "step": 1, "label": "Swatches before “+n”", "default": 4 },
    { "type": "text", "id": "colour_word", "label": "Word for the colour count", "info": "Shown as “Black · 4 colours”.", "default": "colours" },
    { "type": "text", "id": "colour_label", "label": "Swatch group label", "info": "Read out by screen readers before the swatches.", "default": "Colour" },
    { "type": "header", "content": "Card extras" },
    { "type": "checkbox", "id": "show_discount", "label": "Show discount percentage", "default": false },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show save control", "info": "Requires a wishlist app. On its own the control stores nothing, so leave it off until an app is installed.", "default": false },
    { "type": "text", "id": "wishlist_label", "label": "Save control label", "default": "Save" },
    { "type": "header", "content": "Quick add" },
    { "type": "checkbox", "id": "quick_add", "label": "Quick add", "info": "Shows a “+” on each card that opens a size picker, so shoppers can add to the bag without leaving the grid.", "default": true },
    { "type": "text", "id": "quick_add_heading", "label": "Label above the sizes", "default": "Select size" },
    { "type": "text", "id": "quick_add_label", "label": "Add button wording", "default": "Add to bag" },
    { "type": "text", "id": "quick_add_error", "label": "Message when no size is chosen", "default": "Please select a size." },
    { "type": "text", "id": "quick_add_close", "label": "Close control label", "info": "Read out by screen readers.", "default": "Close" },
    { "type": "text", "id": "quick_add_dialog", "label": "Sheet label", "info": "Read out by screen readers when the sheet opens.", "default": "Quick add" },
    {
      "type": "select", "id": "meta_source", "label": "Line above the title", "default": "type",
      "options": [
        { "value": "none", "label": "Nothing" },
        { "value": "type", "label": "Product type" },
        { "value": "fabric", "label": "Fabric metafield" }
      ]
    },
    { "type": "header", "content": "Toolbar" },
    { "type": "text", "id": "toolbar_label", "label": "Toolbar label", "info": "Read out by screen readers when they reach the filter and sort controls.", "default": "Filter and sort" },
    { "type": "checkbox", "id": "sticky_toolbar", "label": "Keep the toolbar in view when scrolling", "default": true },
    { "type": "checkbox", "id": "show_density", "label": "Let shoppers change how many products fit across", "info": "Remembered in the shopper's own browser. No account needed.", "default": true },
    { "type": "text", "id": "density_label", "label": "Grid control label", "info": "Read out by screen readers.", "default": "Grid view" },
    { "type": "header", "content": "Filtering" },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "info": "Filters come from the Search & Discovery app.", "default": true },
    {
      "type": "select", "id": "filter_type", "label": "Filter layout", "default": "drawer",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Sidebar" },
        { "value": "drawer", "label": "Drawer" }
      ]
    },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },
    { "type": "header", "content": "Section" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "editorial",
      "name": "Editorial card",
      "settings": [
        { "type": "paragraph", "content": "Placed inside the grid, after the product position you choose. It only appears if the grid actually reaches that position, so filtering to fewer products hides it rather than stranding it at the end." },
        { "type": "range", "id": "after_product", "min": 2, "max": 24, "step": 1, "label": "Show after product", "default": 8 },
        {
          "type": "select", "id": "span", "label": "Width", "default": "two",
          "options": [
            { "value": "one", "label": "One column" },
            { "value": "two", "label": "Two columns" },
            { "value": "row", "label": "Full row" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New season" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "cta", "label": "Link label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "overlay", "label": "Place the text over the image", "default": true },
        { "type": "color", "id": "text_colour", "label": "Text colour when overlaid", "default": "#FFFFFF" },
        { "type": "range", "id": "scrim", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Darken the image behind the text", "info": "Only used when the text is overlaid. Raise it until the words are comfortably readable.", "default": 20 }
      ]
    }
  ]
}
{% endschema %}
