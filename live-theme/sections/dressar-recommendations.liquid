{%- comment -%}
  You may also like.

  Two sources, in the order the brief asks for:

    1. custom.related_products, when the merchant has chosen the pieces themselves.
    2. Shopify's Product Recommendations API otherwise, through Dawn's own
       <product-recommendations> element — which is already in global.js and gets
       better on its own as orders accumulate.

  The manual list is rendered server-side, so it costs no request at all. Only the
  automatic path fetches, and it fetches this same section back, so the markup stays
  identical whichever source is used.
{%- endcomment -%}

{{ 'dressar-sections.css' | asset_url | stylesheet_tag }}
{{ 'dressar-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dressar-card.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign manual = product.metafields.custom.related_products.value
-%}

<div
  class="dr-section dr-rec color-{{ s.color_scheme }} gradient"
  style="--dr-pt: {{ s.padding_top }}px; --dr-pb: {{ s.padding_bottom }}px;"
>
  {%- if manual != blank and manual.size > 0 -%}
    {%- if s.heading != blank -%}
      <div class="dr-wrap dr-head"><h2 class="dr-head__title">{{ s.heading }}</h2></div>
    {%- endif -%}
    {% render 'dressar-product-rail',
      items: manual,
      ratio: s.image_ratio,
      meta_source: s.meta_source,
      columns: s.columns_desktop,
      mobile_columns: s.columns_mobile,
      show_swatches: s.show_swatches,
      swatch_limit: 4
    %}
  {%- else -%}
    {%- comment -%}
      Dawn's element reads exactly these three attributes and swaps its own contents
      for the fetched ones, so they are reproduced verbatim rather than renamed.
    {%- endcomment -%}
    <product-recommendations
      data-url="{{ routes.product_recommendations_url }}?limit={{ s.products_to_show }}"
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
    >
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- if s.heading != blank -%}
          <div class="dr-wrap dr-head"><h2 class="dr-head__title">{{ s.heading }}</h2></div>
        {%- endif -%}
        {% render 'dressar-product-rail',
          items: recommendations.products,
          ratio: s.image_ratio,
          meta_source: s.meta_source,
          columns: s.columns_desktop,
          mobile_columns: s.columns_mobile,
          show_swatches: s.show_swatches,
          swatch_limit: 4
        %}
      {%- endif -%}
    </product-recommendations>
  {%- endif -%}
</div>

{% stylesheet %}
.dr-rec__grid { list-style: none; margin: 0; }
.dr-rec__grid > li { min-width: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "You may also like",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Uses the product's own \"You may also like\" metafield when it is filled. Otherwise Shopify's automatic recommendations, which improve as orders come in." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 10, "step": 1, "label": "Automatic recommendations to show", "default": 4 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    {
      "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "default": "2",
      "options": [{ "value": "1", "label": "One" }, { "value": "2", "label": "Two" }]
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "portrait",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "45", "label": "Portrait (4:5)" },
        { "value": "natural", "label": "Natural — no crop" }
      ]
    },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour swatches", "default": true },
    {
      "type": "select", "id": "meta_source", "label": "Line above the title", "default": "type",
      "options": [
        { "value": "none", "label": "Nothing" },
        { "value": "type", "label": "Product type" },
        { "value": "fabric", "label": "Fabric metafield" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ]
}
{% endschema %}
