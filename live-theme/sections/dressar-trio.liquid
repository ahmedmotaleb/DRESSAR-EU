{{ 'dressar-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<section
  class="dr-section color-{{ s.color_scheme }} gradient"
  style="--dr-pt: {{ s.padding_top }}px; --dr-pb: {{ s.padding_bottom }}px;"
>
  {%- if s.heading != blank or s.eyebrow != blank -%}
    <div class="dr-wrap dr-head">
      {%- if s.eyebrow != blank -%}<p class="dr-head__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="dr-head__title">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="dr-head__text">{{ s.text }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="dr-wrap{% if s.full_width %} dr-wrap--wide{% endif %}">
    <div class="dr-trio">
      {%- for block in section.blocks -%}
        {%- assign link = block.settings.link -%}
        <article
          class="dr-trio__item{% unless link != blank %} dr-trio__item--unlinked{% endunless %}"
          {{ block.shopify_attributes }}
        >
          {%- comment -%}
            The media duplicates the CTA below and is hidden from assistive tech, so it
            is only a link when there is somewhere to go. As a bare <a href="">, it
            resolved to the current page: clicking a tile reloaded the homepage.
          {%- endcomment -%}
          <{% if link != blank %}a{% else %}div{% endif %}
            class="dr-trio__media"
            {% if link != blank %}href="{{ link }}" tabindex="-1" aria-hidden="true"{% endif %}
          >
            {%- if block.settings.image -%}
              <img
                src="{{ block.settings.image | image_url: width: 1000 }}"
                srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 1000 }} 1000w, {{ block.settings.image | image_url: width: 1400 }} 1400w"
                sizes="(min-width: 750px) 33vw, 100vw"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: '' }}
            {%- endif -%}
          </{% if link != blank %}a{% else %}div{% endif %}>

          {%- if block.settings.eyebrow != blank -%}
            <p class="dr-trio__eyebrow">{{ block.settings.eyebrow }}</p>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3 class="dr-trio__title">{{ block.settings.heading }}</h3>
          {%- endif -%}

          {%- if block.settings.cta != blank and link != blank -%}
            <a class="dr-head__cta" href="{{ link }}">{{ block.settings.cta }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
/* The rule this cancels lives in dressar-sections.css at the same specificity, and the
   load order of a section stylesheet against a linked asset is not guaranteed — so the
   class is doubled to win on specificity rather than on position. */
.dr-trio__item.dr-trio__item--unlinked:hover .dr-trio__media img { transform: none; }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial trio",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "full_width", "label": "Wide layout", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "On our radar" },
        { "type": "text", "id": "heading", "label": "Headline", "default": "Layering, done lightly" },
        { "type": "text", "id": "cta", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial trio",
      "blocks": [{ "type": "story" }, { "type": "story" }, { "type": "story" }]
    }
  ]
}
{% endschema %}
