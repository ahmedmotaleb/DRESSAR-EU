[
  {
    "name": "theme_info",
    "theme_name": "Dressar Ireland",
    "theme_version": "1.0.0",
    "theme_author": "Dressar",
    "theme_documentation_url": "https://github.com/ahmedmotaleb/DRESSAR-EU",
    "theme_support_url": "https://github.com/ahmedmotaleb/DRESSAR-EU/issues"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 260,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 150
      },
      {
        "type": "text",
        "id": "wordmark",
        "label": "Wordmark (used when no logo is set)",
        "default": "DRESSAR"
      },
      {
        "type": "text",
        "id": "wordmark_suffix",
        "label": "Wordmark suffix",
        "default": "IRELAND",
        "info": "Small text shown beside the wordmark."
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social sharing image"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 x 32 px recommended."
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "header",
        "content": "Light"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#FBF8F4"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text",
        "default": "#211E1A"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#6E655A"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders",
        "default": "#E7DFD4"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#41543F"
      },
      {
        "type": "color",
        "id": "color_accent_soft",
        "label": "Accent tint",
        "default": "#EDF1EB"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale",
        "default": "#A4453A"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Headings",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body",
        "default": "work_sans_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading size",
        "default": 100
      }
    ]
  },
  {
    "name": "Ireland & EU",
    "settings": [
      {
        "type": "paragraph",
        "content": "Storefront settings for the Irish market. Delivery rates and VAT are configured in Shopify Settings; these fields control what customers are told on the site."
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free delivery threshold (EUR)",
        "default": "75",
        "info": "Numbers only. Must match your Shopify shipping rate."
      },
      {
        "type": "text",
        "id": "delivery_time_ie",
        "label": "Delivery time — Ireland",
        "default": "2–4 working days"
      },
      {
        "type": "text",
        "id": "delivery_time_eu",
        "label": "Delivery time — rest of EU",
        "default": "4–8 working days"
      },
      {
        "type": "text",
        "id": "returns_window",
        "label": "Returns window (days)",
        "default": "30",
        "info": "EU law requires a minimum 14-day cooling-off period. A longer window is a goodwill offer."
      },
      {
        "type": "checkbox",
        "id": "show_vat_note",
        "label": "Show 'VAT included' note on prices",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_cookie_banner",
        "label": "Enable GDPR cookie banner",
        "default": true,
        "info": "Uses Shopify's Customer Privacy API. Required for visitors in the EU."
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          {
            "value": "portrait",
            "label": "Portrait (3:4)"
          },
          {
            "value": "tall",
            "label": "Tall (2:3)"
          },
          {
            "value": "square",
            "label": "Square"
          }
        ],
        "default": "tall"
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Show colour count",
        "default": true
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      }
    ]
  }
]